{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(?i)(.*order.*|.*transfer.*|.*withdraw.*|.*deposit.*|wire_.*|move_money|liquidate|.*exercise.*|.*assign.*|.*execute.*|close_position|buy_.*|sell_.*|Bash|AskUserQuestion)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/deny_execution.py\""
          }
        ]
      }
    ]
  }
}
